{
  "name": "o11-idx",
  "displayName": "O11 IDX",
  "publisher": "timwm",
  "license": "GPL-2.0-only",
  "version": "2.0.11",
  "icon": "assets/img/icon.png",
  "galleryBanner": {
    "color": "#10151d",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timwm/o11-idx.git"
  },
  "bugs": {
    "url": "https://github.com/timwm/o11-idx/issues"
  },
  "homepage": "https://github.com/timwm/o11-idx#readme",
  "description": "A Beautiful VS Code Theme for Developers",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "O11",
    "IDX",
    "dark"
  ],
  "contributes": {
    "themes": [
      {
        "label": "O11 IDX",
        "uiTheme": "vs-dark",
        "path": "./themes/O11 IDX-color-theme.json"
      }
    ]
  },
  "exports": {
    ".": "./dist/o11-idx-color-theme.json",
    "./package.json": "./package.json"
  },
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "pnpm lint && pnpm vsix:check && vsce package --no-dependencies",
    "build:npm-theme": "node scripts/build-npm-theme.js",
    "prepack": "pnpm build:npm-theme",
    "lint": "biome lint",
    "format": "biome format --write",
    "publish:vscode": "vsce publish --packagePath $npm_package_name-$npm_package_version.vsix",
    "publish:npmjs": "npm publish --access public",
    "ci:publish": "pnpm publish:vscode && pnpm publish:npmjs",
    "ci:release": "pnpm build && pnpm ci:publish",
    "version:check": "node scripts/check-versions.js",
    "vsix:check": "node scripts/check-vsix-contents.js",
    "commit": "cz",
    "commitlint": "commitlint --edit",
    "prepare": "is-ci || husky",
    "clean": "rm -rf *.vsix .biomecache node_modules",
    "contributors": "node scripts/generate-release-contributors.js",
    "contributors:all": "node scripts/generate-release-contributors.js --all",
    "contributors:latest": "node scripts/generate-release-contributors.js --tag $(git describe --tags --abbrev=0)"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@vscode/vsce": "^4.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "jsonc-parser": "^3.3.1",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx}": [
      "biome check --files-ignore-unknown=true",
      "biome check --write --no-errors-on-unmatched",
      "biome check --write --assist-enabled=false --no-errors-on-unmatched",
      "biome check --write --unsafe --no-errors-on-unmatched",
      "biome format --write --no-errors-on-unmatched",
      "biome lint --write --no-errors-on-unmatched"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
